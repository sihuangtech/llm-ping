{
  "name": "llm-ping",
  "version": "0.1.0",
  "private": true,
  "description": "Professional LLM API connectivity, availability and health diagnostics platform.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @llm-ping/server dev",
    "web": "pnpm --filter @llm-ping/web dev",
    "cli": "pnpm --filter @llm-ping/cli dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
