{
  "name": "llm-ping",
  "version": "0.1.0",
  "private": true,
  "description": "Professional LLM API connectivity, availability and health diagnostics platform.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @llm-ping/server dev",
    "web": "pnpm --filter @llm-ping/web dev",
    "cli": "pnpm --filter @llm-ping/cli dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.4.0",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
