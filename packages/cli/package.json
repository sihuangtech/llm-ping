{
  "name": "@llm-ping/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "llm-ping": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @llm-ping/shared build && pnpm --filter @llm-ping/core build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@llm-ping/core": "workspace:*",
    "@llm-ping/shared": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "tsx": "^4.22.3"
  }
}
